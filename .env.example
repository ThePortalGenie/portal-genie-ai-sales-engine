# Zoho CRM read-only connector
# Copy this file to .env and fill in values from the Zoho API Console.
# Never commit .env.

# From https://api-console.zoho.com/ — Self Client is the simplest for a one-person operation.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Must match the redirect URI registered for the client.
# Self Client grant-token flow can keep http://localhost.
# Browser OAuth redirect (Settings → Start OAuth redirect) must use:
#   http://127.0.0.1:8787/api/zoho/oauth/callback
ZOHO_REDIRECT_URI=http://localhost

# Data-centre accounts URL. Use the DC where the Zoho CRM org actually lives.
# US: https://accounts.zoho.com
# EU: https://accounts.zoho.eu
# AU: https://accounts.zoho.com.au
# IN: https://accounts.zoho.in
# JP: https://accounts.zoho.jp
# SA: https://accounts.zoho.sa
# CA: https://accounts.zohocloud.ca
# CN: https://accounts.zoho.com.cn
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Created by: npm run zoho:auth -- --code YOUR_GRANT_TOKEN
ZOHO_REFRESH_TOKEN=

# Optional. Normally taken from the OAuth token response `api_domain`.
# Sandbox example: https://sandbox.zohoapis.eu
# ZOHO_API_DOMAIN=

# Optional. Used only for `npm run zoho:auth -- --code ...`
# ZOHO_GRANT_CODE=

# Local UI (binds to localhost only by default)
APP_HOST=127.0.0.1
APP_PORT=8787

# OpenAI (server-side only; never sent to the browser)
OPENAI_API_KEY=
# Optional. Default is gpt-5.6 (current OpenAI structured-reasoning default; override if needed).
# OPENAI_MODEL=gpt-5.6

# Optional. Character budget for the CommercialEvidenceDigest JSON sent to OpenAI.
# Does not include the system prompt or output schema. Default 10000.
# REASONING_CONTEXT_BUDGET_CHARS=10000

# Optional. Local Sales Event store (operator-entered evidence; never written to Zoho).
# Default: diagnostics/sales-events.json
# SALES_EVENTS_STORE=

# Optional. Organisation-graph expansion caps (one analysis request; not a CRM walk).
# ORG_MAX_CONTACTS=8
# ORG_MAX_ACCOUNTS=5
# ORG_MAX_EMAIL_HEADERS_PER_CONTACT=15
# ORG_MAX_EMAIL_BODIES_PER_CONTACT=4
# ORG_MAX_NOTES_PER_RECORD=20
# ORG_MAX_DEALS=20
